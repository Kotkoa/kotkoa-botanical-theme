<section class="collection-grid color-{{ section.settings.color_scheme }} gradient" style="--collection-grid-padding-top: {{ section.settings.padding_top }}px; --collection-grid-padding-bottom: {{ section.settings.padding_bottom }}px;" {{ section.shopify_attributes }}>
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <h2 class="collection-grid__heading {{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
    {% endif %}

    <div class="collection-grid__items">
      {% for block in section.blocks %}
        {% liquid
          assign card_title = block.settings.title
          assign card_url = block.settings.link
          assign card_image = block.settings.image

          if block.settings.collection != blank
            if card_title == blank
              assign card_title = block.settings.collection.title
            endif
            if card_url == blank
              assign card_url = block.settings.collection.url
            endif
            if card_image == blank
              assign card_image = block.settings.collection.featured_image
            endif
          endif

          assign card_image_alt = card_image.alt | default: card_title
        %}
        <article class="collection-grid__card" {{ block.shopify_attributes }}>
          {% if card_url != blank %}
            <a class="collection-grid__link" href="{{ card_url }}" aria-label="{{ card_title | escape }}">
          {% endif %}
            <div class="collection-grid__media">
              {% if card_image != blank %}
                {{ card_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '375, 550, 750, 900, 1200', sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw', alt: card_image_alt }}
              {% else %}
                <span class="collection-grid__empty-media" aria-hidden="true"></span>
              {% endif %}
            </div>
            {% if card_title != blank %}
              <div class="collection-grid__label">
                <h3 class="collection-grid__title">{{ card_title | escape }}</h3>
                <span class="collection-grid__cta">{{ 'sections.collection_grid.shop_now' | t }}</span>
              </div>
            {% endif %}
          {% if card_url != blank %}
            </a>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .collection-grid {
    padding-top: var(--collection-grid-padding-top);
    padding-bottom: var(--collection-grid-padding-bottom);
  }

  .collection-grid .collection-grid__heading {
    margin: 0 0 2.4rem;
    font-size: 1.7rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-align: center;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .collection-grid__items {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2rem;
  }

  .collection-grid__card {
    position: relative;
    min-width: 0;
  }

  .collection-grid__link {
    position: relative;
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .collection-grid__media {
    position: relative;
    overflow: hidden;
    height: 250px;
    background: rgb(var(--color-foreground) / 0.06);
  }

  .collection-grid__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }

  .collection-grid__link:hover .collection-grid__media img,
  .collection-grid__link:focus-visible .collection-grid__media img {
    transform: scale(1.04);
  }

  .collection-grid__label {
    position: absolute;
    right: 10%;
    bottom: 0;
    left: 10%;
    padding: 2.2rem 1.2rem 1.8rem;
    background: rgb(var(--color-background));
    text-align: center;
  }

  .collection-grid__title {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .collection-grid__cta {
    display: block;
    margin-top: 0.9rem;
    font-size: 1.2rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  @media (prefers-reduced-motion: reduce) {
    .collection-grid__media img {
      transition: none;
    }

    .collection-grid__link:hover .collection-grid__media img,
    .collection-grid__link:focus-visible .collection-grid__media img {
      transform: none;
    }
  }

  @media screen and (max-width: 989px) {
    .collection-grid__items {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .collection-grid {
      padding-top: calc(var(--collection-grid-padding-top) * 0.75);
      padding-bottom: calc(var(--collection-grid-padding-bottom) * 0.75);
    }

    .collection-grid__media {
      height: auto;
      aspect-ratio: 1.14 / 1;
    }

    .collection-grid__items {
      gap: 2.4rem 1.2rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.collection_grid.name",
  "tag": "section",
  "class": "section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.collection_grid.settings.heading.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.collection_grid.settings.heading_size.label",
      "options": [
        { "value": "h2", "label": "t:sections.collection_grid.settings.heading_size.options.small" },
        { "value": "h1", "label": "t:sections.collection_grid.settings.heading_size.options.medium" },
        { "value": "h0", "label": "t:sections.collection_grid.settings.heading_size.options.large" }
      ],
      "default": "h1"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.collection_grid.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.collection_grid.settings.padding_top.label",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.collection_grid.settings.padding_bottom.label",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "t:sections.collection_grid.blocks.collection.name",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:sections.collection_grid.blocks.collection.settings.collection.label"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.collection_grid.blocks.collection.settings.image.label"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.collection_grid.blocks.collection.settings.title.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.collection_grid.blocks.collection.settings.link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.collection_grid.name",
      "blocks": [
        { "type": "collection", "settings": { "title": "Lavender", "link": "shopify://collections/all" } },
        { "type": "collection", "settings": { "title": "Lemon", "link": "shopify://collections/all" } },
        { "type": "collection", "settings": { "title": "Tropical", "link": "shopify://collections/all" } },
        { "type": "collection", "settings": { "title": "Grape & Olive", "link": "shopify://collections/all" } }
      ]
    }
  ]
}
{% endschema %}
