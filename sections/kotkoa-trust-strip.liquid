<section class="trust-strip color-{{ section.settings.color_scheme }} gradient" style="--trust-strip-padding-top: {{ section.settings.padding_top }}px; --trust-strip-padding-bottom: {{ section.settings.padding_bottom }}px;" {{ section.shopify_attributes }}>
  <div class="page-width">
    <div class="trust-strip__grid">
      {% for block in section.blocks %}
        <div class="trust-strip__item" {{ block.shopify_attributes }}>
          <span class="trust-strip__icon" aria-hidden="true"></span>
          <div>
            <h2 class="trust-strip__heading">{{ block.settings.heading | escape }}</h2>
            <p class="trust-strip__text">{{ block.settings.text | escape }}</p>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .trust-strip {
    padding-top: var(--trust-strip-padding-top);
    padding-bottom: var(--trust-strip-padding-bottom);
  }

  .trust-strip__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .trust-strip__item {
    display: flex;
    align-items: center;
    gap: 1.8rem;
    min-height: 7rem;
    padding: 0 2.8rem;
  }

  .trust-strip__item + .trust-strip__item {
    border-left: 0.1rem solid rgb(var(--color-foreground) / 0.08);
  }

  .trust-strip__icon {
    flex: 0 0 auto;
    width: 2.6rem;
    height: 2.6rem;
    border: 0.1rem solid currentcolor;
    border-radius: 50%;
  }

  .trust-strip__heading {
    margin: 0;
    font-family: var(--font-body-family);
    font-size: 1.4rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .trust-strip__text {
    margin: 0.6rem 0 0;
    font-size: 1.3rem;
    line-height: 1.3;
  }

  @media screen and (max-width: 989px) {
    .trust-strip__item {
      padding: 0 1.6rem;
    }
  }

  @media screen and (max-width: 749px) {
    .trust-strip__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .trust-strip__item {
      min-height: 9rem;
      padding: 1.6rem;
    }

    .trust-strip__item + .trust-strip__item {
      border-left: 0;
    }

    .trust-strip__item:nth-child(even) {
      border-left: 0.1rem solid rgb(var(--color-foreground) / 0.08);
    }

    .trust-strip__item:nth-child(n + 3) {
      border-top: 0.1rem solid rgb(var(--color-foreground) / 0.08);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.trust_strip.name",
  "tag": "section",
  "class": "section",
  "max_blocks": 8,
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.trust_strip.settings.color_scheme.label", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "t:sections.trust_strip.settings.padding_top.label", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 20 },
    { "type": "range", "id": "padding_bottom", "label": "t:sections.trust_strip.settings.padding_bottom.label", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 20 }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "t:sections.trust_strip.blocks.benefit.name",
      "settings": [
        { "type": "text", "id": "heading", "label": "t:sections.trust_strip.blocks.benefit.settings.heading.label", "default": "Benefit" },
        { "type": "text", "id": "text", "label": "t:sections.trust_strip.blocks.benefit.settings.text.label", "default": "Short supporting text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.trust_strip.name",
      "blocks": [
        { "type": "benefit", "settings": { "heading": "Secure payments", "text": "Safe & encrypted checkout" } },
        { "type": "benefit", "settings": { "heading": "Free shipping", "text": "On orders over $100" } },
        { "type": "benefit", "settings": { "heading": "Easy returns", "text": "30 days return policy" } },
        { "type": "benefit", "settings": { "heading": "Customer support", "text": "We're here to help" } }
      ]
    }
  ]
}
{% endschema %}
