<section class="seasonal-collections color-{{ section.settings.color_scheme }} gradient" style="--seasonal-collections-padding-top: {{ section.settings.padding_top }}px; --seasonal-collections-padding-bottom: {{ section.settings.padding_bottom }}px; --seasonal-collections-panel-background: {{ section.settings.panel_background }};" {{ section.shopify_attributes }}>
  <div class="page-width">
    <div class="seasonal-collections__panel">
      {% if section.settings.heading != blank %}
        <h2 class="seasonal-collections__heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <p class="seasonal-collections__subheading">{{ section.settings.subheading | escape }}</p>
      {% endif %}

      <div class="seasonal-collections__items">
        {% for block in section.blocks %}
          {% liquid
            assign card_title = block.settings.title
            assign card_accessible_title = card_title
            assign card_url = block.settings.link
            assign card_image = block.settings.image

            if block.settings.collection != blank
              if card_accessible_title == blank
                assign card_accessible_title = block.settings.collection.title
              endif
              if card_url == blank
                assign card_url = block.settings.collection.url
              endif
              if card_image == blank
                unless block.settings.use_hero_image
                  assign card_image = block.settings.collection.featured_image
                endunless
              endif
            endif
          %}
          <article class="seasonal-collections__card" {{ block.shopify_attributes }}>
            {% if card_url != blank %}
              <a class="seasonal-collections__link" href="{{ card_url }}" aria-label="{{ card_accessible_title | escape }}">
            {% endif %}
              <div class="seasonal-collections__media">
                {% if card_image != blank %}
                  {{ card_image | image_url: width: 2000 | image_tag: loading: 'lazy', widths: '400, 600, 800, 1200, 1600, 2000', sizes: '(min-width: 750px) calc(100vw - 10rem), calc(100vw - 4.8rem)', alt: card_accessible_title }}
                {% else %}
                  <img src="{{ 'botanical-hero-image.png' | asset_url }}" width="1915" height="821" loading="lazy" alt="{{ card_accessible_title | escape }}">
                {% endif %}
              </div>
              {% if card_title != blank %}
                <h3 class="seasonal-collections__title">{{ card_title | escape }}</h3>
              {% endif %}
            {% if card_url != blank %}
              </a>
            {% endif %}
          </article>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .seasonal-collections {
    padding-top: var(--seasonal-collections-padding-top);
    padding-bottom: var(--seasonal-collections-padding-bottom);
  }

  .seasonal-collections__panel {
    padding: 1.2rem 2rem 1.6rem;
    border-radius: 8px;
    background: var(--seasonal-collections-panel-background);
  }

  .seasonal-collections__heading {
    margin: 0;
    font-family: var(--font-heading-family);
    font-size: 2.5rem;
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    letter-spacing: 0.08em;
    line-height: 1;
    text-align: center;
    text-transform: uppercase;
  }

  .seasonal-collections__subheading {
    margin: 0.4rem 0 1.5rem;
    font-size: 0.9rem;
    letter-spacing: 0.16em;
    line-height: 1;
    text-align: center;
    text-transform: uppercase;
  }

  .seasonal-collections__items {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: 1rem;
  }

  .seasonal-collections__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .seasonal-collections__media {
    overflow: hidden;
    border-radius: 4px;
    aspect-ratio: 1 / 1;
    background: rgb(var(--color-foreground) / 0.06);
  }

  .seasonal-collections__card:only-child .seasonal-collections__media {
    height: 175px;
    aspect-ratio: auto;
  }

  .seasonal-collections__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }

  .seasonal-collections__link:hover .seasonal-collections__media img,
  .seasonal-collections__link:focus-visible .seasonal-collections__media img {
    transform: scale(1.04);
  }

  .seasonal-collections__title {
    margin: 0.8rem 0 0;
    font-family: var(--font-body-family);
    font-size: 1.2rem;
    font-style: var(--font-body-style);
    font-weight: var(--font-body-weight);
    letter-spacing: 0.12em;
    line-height: 1.2;
    text-align: center;
    text-transform: uppercase;
  }

  @media screen and (max-width: 749px) {
    .seasonal-collections__panel {
      padding: 1.6rem 1.2rem;
    }

    .seasonal-collections__items {
      gap: 1.2rem 0.8rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .seasonal-collections__media img {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.seasonal_collections.name",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "heading", "label": "t:sections.seasonal_collections.settings.heading.label", "default": "Seasonal collections" },
    { "type": "text", "id": "subheading", "label": "t:sections.seasonal_collections.settings.subheading.label", "default": "Celebrate every season with botanical charm" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.seasonal_collections.settings.color_scheme.label", "default": "scheme-1" },
    { "type": "color", "id": "panel_background", "label": "t:sections.seasonal_collections.settings.panel_background.label", "default": "#d1d0b1" },
    { "type": "range", "id": "padding_top", "label": "t:sections.seasonal_collections.settings.padding_top.label", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom", "label": "t:sections.seasonal_collections.settings.padding_bottom.label", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32 }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "t:sections.seasonal_collections.blocks.collection.name",
      "settings": [
        { "type": "collection", "id": "collection", "label": "t:sections.seasonal_collections.blocks.collection.settings.collection.label" },
        { "type": "image_picker", "id": "image", "label": "t:sections.seasonal_collections.blocks.collection.settings.image.label" },
        { "type": "checkbox", "id": "use_hero_image", "label": "t:sections.seasonal_collections.blocks.collection.settings.use_hero_image.label", "default": false },
        { "type": "text", "id": "title", "label": "t:sections.seasonal_collections.blocks.collection.settings.title.label" },
        { "type": "url", "id": "link", "label": "t:sections.seasonal_collections.blocks.collection.settings.link.label" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.seasonal_collections.name",
      "blocks": [
        { "type": "collection", "settings": { "title": "Autumn" } },
        { "type": "collection", "settings": { "title": "Christmas" } },
        { "type": "collection", "settings": { "title": "Winter" } },
        { "type": "collection", "settings": { "title": "Valentine's day" } },
        { "type": "collection", "settings": { "title": "Easter" } },
        { "type": "collection", "settings": { "title": "Summer" } }
      ]
    }
  ]
}
{% endschema %}
